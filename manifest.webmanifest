{
  "name": "เหลือเก็บ",
  "short_name": "เหลือเก็บ",
  "description": "กินเหลือเก็บ เติมโอ่งทุกเดือน จดรายรับรายจ่าย ตั้งงบ และเป้าหมายออม",
  "lang": "th",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f3ee",
  "theme_color": "#f5f3ee",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {
      "name": "จดรายจ่าย",
      "short_name": "รายจ่าย",
      "description": "จดรายจ่ายใหม่",
      "url": "./?add=out",
      "icons": [
        {
          "src": "sc-expense.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "จดรายรับ",
      "short_name": "รายรับ",
      "description": "จดรายรับใหม่",
      "url": "./?add=in",
      "icons": [
        {
          "src": "sc-income.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "ค้นหารายการ",
      "short_name": "ค้นหา",
      "description": "ค้นหารายการย้อนหลัง",
      "url": "./?find=1",
      "icons": [
        {
          "src": "sc-search.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "slips",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ]
        }
      ]
    }
  }
}